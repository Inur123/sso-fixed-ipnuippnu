# APLIKASI FRONTEND (FE) - salin menjadi frontend/.env.local
# Nilai NEXT_PUBLIC_* terlihat oleh browser; jangan simpan secret di sini.

# URL publik BACKEND (BE)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Nama cookie HttpOnly sesi BACKEND yang dibaca Next.js saat server render.
BACKEND_SESSION_COOKIE_NAME=sso_session
NEXT_PUBLIC_DOCUMENTATION_URL=http://localhost:3001

# Identitas tampilan aplikasi FRONTEND (FE)
NEXT_PUBLIC_APP_NAME="PelajarNU Magetan ID"
NEXT_PUBLIC_APP_TAGLINE="Single Sign-On"
NEXT_PUBLIC_APP_DESCRIPTION="Pusat identitas dan Single Sign-On resmi PC IPNU IPPNU Kabupaten Magetan."
NEXT_PUBLIC_ORGANIZATION_NAME="PC IPNU IPPNU Kabupaten Magetan"

# Cloudflare Turnstile. Nilai ini adalah test sitekey resmi untuk localhost.
# Production wajib memakai sitekey widget milik sendiri dari Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
