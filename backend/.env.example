# =============================================================
# APLIKASI BACKEND (BE) - salin menjadi backend/.env
# =============================================================
APP_ENV=development
APP_NAME="IPNU IPPNU Magetan ID"
BACKEND_PORT=8080

# URL publik BACKEND (BE) / issuer OAuth-OIDC
BACKEND_PUBLIC_URL=http://localhost:8080

# URL publik FRONTEND (FE) / portal akun
FRONTEND_PUBLIC_URL=http://localhost:3000

# Origin FRONTEND (FE) yang diizinkan oleh CORS BACKEND (BE)
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookie sesi HttpOnly. Kosongkan domain jika BE dan FE memakai host yang sama.
# Production subdomain contoh: SESSION_COOKIE_DOMAIN=.ipnuippnu.id
SESSION_COOKIE_NAME=sso_session
SESSION_COOKIE_DOMAIN=

# Database PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=ipnu_ippnu_id_sso
DB_PORT=5432
DB_SSLMODE=disable
# Pool koneksi BE. Default ini cukup untuk ratusan pengguna dan dapat disetel
# menurut batas koneksi PostgreSQL server.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=5

# Security (generate nilai random baru; jangan pakai nilai dokumentasi ini di production)
JWT_SECRET=development-only-replace-with-random-secret
# Kunci AES-256-GCM untuk client secret: base64 standar dari tepat 32 byte.
# Wajib dan harus terpisah pada production. Contoh generate:
# openssl rand -base64 32
CLIENT_SECRET_ENCRYPTION_KEY=
# Kunci HMAC OTP terpisah, minimal 32 karakter dan berbeda dari JWT_SECRET.
OTP_HASH_SECRET=development-only-replace-with-another-secret
# Path absolut RSA private key PKCS#1/PKCS#8 minimal 2048-bit untuk ID token RS256.
# Wajib pada production; development membuat ephemeral key jika kosong.
OIDC_PRIVATE_KEY_PATH=
SUPER_ADMIN_EMAIL=your-admin@example.com

# SMTP OTP (rahasia, hanya berada di BACKEND)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-account@gmail.com
MAIL_FROM_NAME="SSO IPNU IPPNU Magetan ID"
MAIL_OTP_TTL_MINUTES=10

# Provisioning assignment ke aplikasi tujuan (opsional, hanya BACKEND).
# Key object adalah OAuth Client ID; URL menerima CloudEvents user.assigned dan
# user.unassigned. Secret acak minimal 32 karakter harus sama dengan secret BE
# aplikasi tujuan. Kosongkan object jika provisioning belum digunakan.
# Generate secret: openssl rand -hex 32
PROVISIONING_TARGETS_JSON={}
PROVISIONING_MAX_ATTEMPTS=12
# Maksimum request provisioning yang dikirim paralel oleh satu instance BE.
PROVISIONING_CONCURRENCY=4

# Daftar IP/CIDR reverse proxy tepercaya, dipisahkan koma. Kosongkan jika BE
# menerima trafik langsung. Jangan gunakan 0.0.0.0/0.
BACKEND_TRUSTED_PROXIES=
